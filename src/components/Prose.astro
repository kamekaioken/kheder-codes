---
/** The rendered body of a markdown page — legal documents, team profiles. The
 *  page heading is the `<h1>` of the surrounding `Section`, so a document starts
 *  its own outline at `<h2>`. */
---

<div class="prose">
	<slot />
</div>

<style>
	.prose {
		font-size: 15px;
		line-height: 1.8;
		color: var(--color-dim);
	}

	.prose :global(h2) {
		margin: 40px 0 12px;
		font-size: 17px;
		font-weight: 700;
		color: var(--color-fg);
	}

	.prose :global(h3) {
		margin: 28px 0 10px;
		font-size: 15px;
		font-weight: 700;
		color: var(--color-fg);
	}

	.prose :global(:is(h2, h3):first-child) {
		margin-top: 0;
	}

	.prose :global(p),
	.prose :global(address) {
		margin: 0 0 14px;
		font-style: normal;
	}

	/* Tailwind's preflight strips list markers; a document's lists want them back. */
	.prose :global(ul) {
		margin: 0 0 14px;
		padding-left: 20px;
		list-style: disc;
	}

	.prose :global(li) {
		margin-bottom: 4px;
	}

	.prose :global(strong) {
		font-weight: 700;
		color: var(--color-fg);
	}

	.prose :global(code) {
		border: 1px solid var(--color-line);
		border-radius: 4px;
		padding: 1px 5px;
		font-size: 13px;
	}
</style>
