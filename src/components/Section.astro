---
/** The page itself: the kicker, the one `<h1>` the document has, and the copy
 *  underneath. The terminal alongside carries no headings of its own — the
 *  outline belongs to whatever is being read. */
interface Props {
	kicker: string;
	heading: string;
	headingSpace?: string;
}

const { kicker, heading, headingSpace = 'mb-[18px]' } = Astro.props;
---

<section class="mx-auto box-border w-full max-w-[760px] px-5 pt-14 pb-10 animate-fade-up">
	<div class="mb-2.5 text-[13px] text-dim">{kicker}</div>
	<h1
		class:list={[
			'font-display m-0 text-heading font-extrabold tracking-[-0.02em]',
			headingSpace,
		]}
	>
		{heading}
	</h1>
	<slot />
</section>
