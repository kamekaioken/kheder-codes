---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import type { Locale } from '../lib/i18n';
import type { LegalDoc } from '../lib/legal';
import { m } from '../paraglide/messages.js';

interface Props {
	locale: Locale;
	legalDocs: LegalDoc[];
}

const { locale, legalDocs } = Astro.props;
const o = { locale };
---

<footer
	data-hide-on-hero
	class="mx-auto mt-auto box-border flex w-full max-w-[760px] flex-wrap items-center gap-x-4 gap-y-2 px-5 pt-12 pb-8 text-xs text-dim"
>
	<Image src={logo} alt="KHEDER.codes" height={34} densities={[1, 2]} class="logo-themed h-[34px] w-auto" />
	<span>{m.footer_copyright({}, o)}</span>

	<nav class="flex gap-4" aria-label={m.footer_legal_label({}, o)} data-testid="footer-legal">
		{legalDocs.map((doc) => <a href={doc.href}>{doc.title}</a>)}
	</nav>

	<span class="ml-auto">{m.footer_exit({}, o)}</span>
</footer>
