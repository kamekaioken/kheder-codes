---
import { type CollectionEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { neighboursOf } from '../../lib/docs';
import { alternatesFor, type Locale } from '../../lib/i18n';
import { getLegalDocs } from '../../lib/legal';
import { m } from '../../paraglide/messages.js';
import DocNav from '../DocNav.astro';
import Prose from '../Prose.astro';
import Section from '../Section.astro';

interface Props {
	locale: Locale;
	entry: CollectionEntry<'legal'>;
}

const { locale, entry } = Astro.props;
const { Content } = await render(entry);
const file = `${entry.id}.md`;
const { prev, next } = neighboursOf(await getLegalDocs(), file);

const updated = new Intl.DateTimeFormat('de-DE', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(entry.data.updated);
---

<Base
	{locale}
	current={entry.data.route}
	currentDocFile={file}
	title={`${entry.data.title} — kheder.codes`}
	description={entry.data.description}
	alternates={alternatesFor(entry.data.route)}
>
	<Section
		kicker={entry.data.kicker}
		heading={entry.data.title}
		headingSpace="mb-2"
	>
		<p class="mb-9 text-[13px] text-dim" data-testid="legal-updated">Stand: {updated}</p>

		<Prose>
			<Content />
		</Prose>

		<DocNav {locale} {prev} {next} />

		<p class="mt-6 text-[13px] text-dim">{m.legal_back({}, { locale })}</p>
	</Section>
</Base>
