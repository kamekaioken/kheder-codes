---
import Base from '../../layouts/Base.astro';
import { alternatesFor, type Locale } from '../../lib/i18n';
import { m } from '../../paraglide/messages.js';
import Section from '../Section.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const o = { locale };
---

<Base
	{locale}
	current="settings"
	title={m.settings_title({}, o)}
	description={m.settings_description({}, o)}
	alternates={alternatesFor('settings')}
>
	<Section
		kicker={m.settings_kicker({}, o)}
		heading={m.settings_h2({}, o)}
	>
		<p class="m-0 text-[15px] leading-[1.8] text-dim">{m.settings_body({}, o)}</p>
	</Section>
</Base>
