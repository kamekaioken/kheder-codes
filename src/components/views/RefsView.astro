---
import Base from '../../layouts/Base.astro';
import { alternatesFor, type Locale } from '../../lib/i18n';
import { references } from '../../lib/site';
import { m } from '../../paraglide/messages.js';
import Section from '../Section.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const o = { locale };

const descriptions = {
	donna: m.refs_donna({}, o),
	hannover: m.refs_hannover({}, o),
	giz: m.refs_giz({}, o),
	wts: m.refs_wts({}, o),
	dzr: m.refs_dzr({}, o),
};
---

<Base
	{locale}
	current="refs"
	title={m.refs_title({}, o)}
	description={m.refs_description({}, o)}
	alternates={alternatesFor('refs')}
>
	<Section
		kicker={m.refs_kicker({}, o)}
		heading={m.refs_heading({}, o)}
		headingSpace="mb-2"
	>
		<p class="m-0 text-[15px] leading-[1.8] text-dim">{m.refs_intro({}, o)}</p>

		<ul class="m-0 flex list-none flex-col p-0">
			{
				references.map((reference, index) => (
					<li
						class:list={[
							'flex flex-col gap-2.5 py-[22px]',
							index < references.length - 1 && 'border-b border-dashed border-line',
						]}
					>
						<span class="text-base font-bold">
							{reference.name}
							{reference.href && (
								<Fragment>
									{' '}
									<a
										href={reference.href}
										target="_blank"
										rel="noopener"
										class="text-[13px]"
									>
										↗
									</a>
								</Fragment>
							)}
						</span>
						<span class="text-sm leading-[1.7] text-dim">
							{descriptions[reference.id]}
						</span>
						<ul
							class="m-0 flex list-none flex-wrap gap-2 p-0"
							aria-label={`${m.refs_stack_label({}, o)}: ${reference.name}`}
						>
							{reference.stack.map((item) => (
								<li class="rounded-md border border-line px-2.5 py-1 text-[13px] text-dim">
									{item}
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>
	</Section>
</Base>
